<!--suppress XmlUnboundNsPrefix -->
<Configuration shutdownHook="disable" status="WARN">
    <Appenders>
        <!-- The TUI owns the terminal. The appender sends plain text over its Unix socket. -->
        <!--<UnixSocket name="TuiLog" path="${sys:habbo.tui.socket:-/tmp/habbo-r63b.sock}"
                    pattern="%d{dd/MM/yyyy HH:mm:ss:SSS}"/>-->

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%highlight{%d{dd/MM/yyyy HH:mm:ss:SSS} - [%-5level] --> (%logger{1}/%t) -> %msg%n}"/>
        </Console>

        <!-- Plain-text stress-test metrics file (truncated on each start) -->
        <File name="StressTestFile" fileName="stress-test.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss:SSS} [%-5level] %msg%n"/>
        </File>
    </Appenders>
    <loggers>
        <Root level="info">
            <!--            <AppenderRef ref="TuiLog"/>-->
            <AppenderRef ref="Console"/>
        </Root>

        <Logger name="ovh.rwx" level="trace"/>

        <!-- Stress-test metrics -> file only (not console), avoids IDE truncation -->
        <Logger name="ovh.rwx.habbo.stress" level="off" additivity="false">
            <AppenderRef ref="StressTestFile"/>
        </Logger>

        <!-- Suppress per-packet incoming/outgoing TRACE flood on the console -->
        <!--        <Logger name="ovh.rwx.habbo.netty.HabboNettyDecoder" level="info"/>-->
        <!--        <Logger name="ovh.rwx.habbo.netty.HabboNettyEncoder" level="info"/>-->

        <Logger name="ovh.rwx.habbo.camera" level="debug"/>
        <Logger name="com.github.andrewoma.kwery" level="error"/>
        <Logger name="io.netty" level="error"/>
        <Logger name="com.zaxxer" level="error"/>
        <Logger name="org.reflections8" level="error"/>
        <Logger name="org.hibernate" level="error"/>
        <Logger name="io.undertow" level="error"/>
        <Logger name="org.xnio" level="error"/>
        <Logger name="org.jboss" level="error"/>
        <Logger name="org.springframework" level="error" additivity="false"/>
        <Logger name="org.mariadb" level="error"/>
    </loggers>
</Configuration>
